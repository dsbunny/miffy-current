{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"inlineSources": true,
		"outDir": "./build",
		"rootDir": "./",
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": false,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitThis": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"forceConsistentCasingInFileNames": true,
		"composite": true,
		"skipLibCheck": true,
		"plugins": [
			{
				"name": "ts-lit-plugin",
				"strict": true
			}
		],
		"paths": {
			"@msgpack/msgpack": ["./third-party/@msgpack/msgpack"],
			"cordova": ["./third-party/cordova"],
			"cordova-cd": ["./third-party/cordova-cd"],
			"rrule": ["./third-party/rrule"],
			"three/addons/*": [
				"./node_modules/@types/three/examples/jsm/*"
			]
		}
	},
	"exclude": [
		"node_modules",
		"test"
	]
}
